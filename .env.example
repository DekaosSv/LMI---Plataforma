# Configuración del Agente LMI (Sentinel / Copilot)

# 1. Token de tu Bot de Telegram (Obtenlo con @BotFather en Telegram)
TELEGRAM_BOT_TOKEN="TU_TELEGRAM_BOT_TOKEN_AQUI"

# 2. Clave de API de DeepSeek (Obtenla en https://platform.deepseek.com)
DEEPSEEK_API_KEY="TU_DEEPSEEK_API_KEY_AQUI"

# 3. Tu ID numérico de Telegram (Para que solo tú puedas dar órdenes al bot)
# Si lo dejas vacío, el bot aceptará mensajes de cualquier usuario autorizado o te mostrará tu ID al escribirle /start
TELEGRAM_ALLOWED_USER_ID=""

# 4. Configuración del modelo DeepSeek
DEEPSEEK_MODEL="deepseek-chat"
